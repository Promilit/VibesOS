{
  "name": "@uservibes/kanban-widget",
  "version": "1.0.0",
  "description": "Embeddable Kanban widget for collecting user feedback",
  "type": "module",
  "main": "dist/uservibes-widget.umd.js",
  "module": "dist/uservibes-widget.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uservibes-widget.es.js",
      "require": "./dist/uservibes-widget.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy-to-public",
    "copy-to-public": "mkdir -p ../public/widget && cp dist/uservibes-widget.umd.js dist/uservibes-widget.umd.js.map ../public/widget/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.49.0",
    "convex": "^1.27.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "terser": "^5.44.1",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "keywords": [
    "kanban",
    "widget",
    "feedback",
    "embeddable",
    "web-component",
    "uservibes",
    "feature-request",
    "roadmap",
    "voting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uservibes/kanban-widget"
  },
  "homepage": "https://uservibes.com",
  "bugs": {
    "url": "https://github.com/uservibes/kanban-widget/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  }
}
